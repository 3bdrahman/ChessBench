# ChessBench Environment Configuration Example
# Copy this file to `.env` and fill in your API keys as needed.

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
NIM_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=

# Any OpenAI-compatible Chat Completions endpoint
# Include the API prefix expected by the server (commonly /v1).
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=
# Optional fallback when the endpoint does not implement GET /models.
OPENAI_COMPATIBLE_MODELS=
OPENAI_COMPATIBLE_CONTEXT_WINDOW=32768
# Optional JSON objects for provider-specific authentication/query parameters.
OPENAI_COMPATIBLE_HEADERS={}
OPENAI_COMPATIBLE_QUERY={}
OPENAI_COMPATIBLE_EXTRA_BODY={}
# Compatibility toggles (tools default off; temperature defaults on).
OPENAI_COMPATIBLE_SUPPORTS_TOOLS=false
OPENAI_COMPATIBLE_SEND_TEMPERATURE=true
OPENAI_COMPATIBLE_MAX_TOKENS_FIELD=max_tokens
OPENAI_COMPATIBLE_PROBE_TIMEOUT=10
# Harden public/server deployments against SSRF. Local deployments may leave
# this false or explicitly allow private targets below.
OPENAI_COMPATIBLE_ENFORCE_PUBLIC_NETWORKS=false
OPENAI_COMPATIBLE_ALLOW_PRIVATE_NETWORKS=false
OPENAI_COMPATIBLE_ALLOWED_HOSTS=
OPENAI_COMPATIBLE_TRUST_ENV=false
CHESSBENCH_PUBLIC_DEPLOYMENT=true
# Only enable this on a trusted private deployment.
CHESSBENCH_ALLOW_PRIVATE_ENDPOINTS=false

# Engine Configuration
STOCKFISH_PATH=/usr/games/stockfish

# Storage & Hosted Settings
CHESSBENCH_RUNS_ROOT=runs
CHESSBENCH_HOSTED_PROVIDERS=openrouter,nim
